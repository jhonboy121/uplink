# Arabic for uplink. Modern Standard Arabic, written for a phone screen: short, and "uplink"
# stays in Latin letters as the app's name. `just tr-check` lists anything the markup has that
# this file lacks.
#
# A placeholder that carries a name, a version or an error's own text is wrapped in the invisible
# U+2068 FIRST STRONG ISOLATE … U+2069 POP DIRECTIONAL ISOLATE, so a Latin name ending in "." or
# ")" keeps its punctuation on its own side of an Arabic sentence.
msgid ""
msgstr ""
"Language: ar\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=6; plural=(n==0 ? 0 : n==1 ? 1 : n==2 ? 2 : n%100>=3 && n%100<=10 ? 3 : n%100>=11 ? 4 : 5);\n"

