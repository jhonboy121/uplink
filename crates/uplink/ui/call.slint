// A call: the whole window while it rings and runs, or folded into a corner so the rest of the
// app can be used.

import { Theme } from "theme.slint";
import { CallCapture, CallState, Output, OutputItem, Route, Stall, Weak } from "types.slint";
import { BigAvatar, DragTap, Key, Line, Row, Tap } from "controls.slint";

// A label on the call's scrim: how the call is set up.
component Chip inherits VerticalLayout {
    in property <string> text;
    in property <color> fill;
    in property <color> edge;
    in property <color> ink;
    alignment: start;
    Rectangle {
        height: Theme.chip-height;
        border-radius: self.height / 2;
        background: root.fill;
        border-width: 1px;
        border-color: root.edge;
        HorizontalLayout {
            padding-left: Theme.chip-pad;
            padding-right: Theme.chip-pad;
            Text {
                text: root.text;
                color: root.ink;
                font-family: Theme.mono;
                font-size: 0.75rem;
                letter-spacing: Theme.joined ? 0 : 0.34px;
                vertical-alignment: center;
            }
        }
    }
}

// A call folded into a corner, so the rest of the app is usable while it runs. Adding a
// contact or sending diagnostics mid-call should not mean hanging up, and picture-in-picture
// does not help here — the user has not left uplink, which is the common case.
//
// It keeps its own position so a drag survives being restored and folded away again, and it
// is clamped on every layout rather than only while dragging, so rotating cannot strand it
// off screen.
export component MiniCall inherits Rectangle {
    in property <image> frame;
    in property <string> timer;
    // What it has to stay clear of at each end: the system bars, and the tab bar it would
    // otherwise sit on top of and make unreachable.
    in property <length> top-clear;
    in property <length> bottom-clear;
    // The window, which a component cannot ask for: inside it, `parent` is itself.
    in property <length> area-width;
    in property <length> area-height;
    in-out property <length> pos-x;
    in-out property <length> pos-y;
    in-out property <bool> placed;
    callback restore();

    width: Theme.mini-width;
    height: Theme.mini-height;
    property <length> lowest: root.area-height - self.height - root.bottom-clear - Theme.mini-edge;
    property <length> end-x: Theme.rtl ? Theme.mini-edge : root.area-width - self.width - Theme.mini-edge;
    x: clamp(root.pos-x, Theme.mini-edge, root.area-width - self.width - Theme.mini-edge);
    y: clamp(root.pos-y, root.top-clear + Theme.mini-edge, max(root.top-clear + Theme.mini-edge, lowest));
    // First shown, it rests in the end corner, nearest where the call controls were.
    init => {
        if (!root.placed) {
            root.pos-x = root.end-x;
            root.pos-y = root.lowest;
            root.placed = true;
        }
    }
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: #FFFFFF3D;
    background: Theme.video;
    clip: true;
    drop-shadow-blur: 18px;
    drop-shadow-color: #00000080;

    Image {
        width: parent.width;
        height: parent.height;
        source: root.frame;
        image-fit: cover;
    }
    // The timer says it is still running even when the face has not arrived yet.
    Rectangle {
        y: parent.height - self.height;
        height: 22px;
        background: @linear-gradient(0deg, #04080DCC 0%, #04080D00 100%);
        Text {
            text: root.timer;
            color: Theme.on-video;
            font-family: Theme.mono;
            font-size: 0.6875rem;
            vertical-alignment: center;
        }
    }
    DragTap {
        tapped => { root.restore(); }
        dragged(dx, dy) => {
            root.pos-x = root.x + dx;
            root.pos-y = root.y + dy;
        }
    }
}

// A state of theirs, said over their video in words and an icon, never in colour alone.
component Flag inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <length> icon-size: Theme.flag-icon;
    height: Theme.flag-height;
    width: row.preferred-width;
    border-radius: self.height / 2;
    background: Theme.flag-fill;
    border-width: 1px;
    border-color: Theme.flag-edge;
    row := Row {
        padding-left: Theme.rtl ? Theme.flag-pad-end : Theme.flag-pad-start;
        padding-right: Theme.rtl ? Theme.flag-pad-start : Theme.flag-pad-end;
        spacing: Theme.flag-gap;
        cross-axis-alignment: center;
        Image {
            source: root.icon;
            width: root.icon-size;
            height: root.icon-size;
            colorize: Theme.on-video;
        }
        Text {
            text: root.text;
            color: Theme.on-video;
            font-size: 0.771rem;
            vertical-alignment: center;
        }
    }
}

// Three dots that pulse in turn while the call tries to come back.
// A camera is off: said, rather than holding the last frame.
component CameraOff inherits Rectangle {
    background: Theme.video-raised;
    Image {
        source: @image-url("icons/video-off.svg");
        width: Theme.camera-off-icon;
        height: Theme.camera-off-icon;
        colorize: Theme.on-video-muted;
    }
}

component Dots inherits Row {
    spacing: Theme.dot-gap;
    alignment: center;
    for index in 3 : Rectangle {
        // Faint, bright at 40% of the cycle, faint again: the design's `dot` keyframes.
        property <float> phase: mod((animation-tick() + Theme.dot-cycle - index * Theme.dot-stagger) / 1ms, Theme.dot-cycle / 1ms) / (Theme.dot-cycle / 1ms);
        width: Theme.dot;
        height: Theme.dot;
        border-radius: self.width / 2;
        background: Theme.on-video;
        opacity: phase < 0.4 ? 0.25 + phase / 0.4 * 0.75 : 1.0 - (phase - 0.4) / 0.6 * 0.75;
    }
}

// Who is on a voice call, in the middle of the screen: the avatar, the name, and a line or two
// under it.
component VoiceFace inherits VerticalLayout {
    in property <string> initial;
    in property <string> name;
    alignment: center;
    spacing: Theme.call-top;
    BigAvatar { initial: root.initial; }
    VerticalLayout {
        Text {
            text: root.name;
            color: Theme.on-video;
            font-family: Theme.display;
            font-size: 1.4375rem;
            font-weight: 600;
            height: self.font-size * Theme.line-box;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        @children
    }
}

component CallTimer inherits Text {
    color: Theme.on-video-muted;
    font-size: 1rem;
    font-family: Theme.mono;
    height: self.font-size * Theme.line-box;
    horizontal-alignment: center;
    vertical-alignment: center;
}

// The whole window while a call is up: video owns the frame, chrome sits on a scrim. A voice
// call puts the person in the middle instead, on the plain call surface.
export component CallScreen inherits Rectangle {
    in property <image> frame;
    in property <image> remote-frame;
    in property <string> peer-name;
    in property <string> peer-initial;
    in property <string> timer;
    in property <Route> route;
    // Set when the video never came up, or stopped: audio with no picture otherwise looks
    // exactly like a call where nobody moved.
    in property <bool> video-failed;
    in property <CallState> state;
    in-out property <bool> swapped;
    // Where the corner card was dragged to, if it was.
    in-out property <length> card-x;
    in-out property <length> card-y;
    in-out property <bool> card-placed;
    in property <bool> mic-on;
    // Where the sound can go, and which of them it goes to now (-1 before Android has said).
    in property <[OutputItem]> outputs;
    in property <int> output-index: -1;
    // Mute chosen as the output.
    in property <bool> silenced;
    // A phone call was answered over this one: here, or on their phone.
    in property <bool> held;
    in property <bool> peer-held;
    // Placed or offered as voice, and not switched to video since.
    in property <bool> voice;
    in property <bool> camera-on: true;
    // What they said about their own mic and camera.
    in property <bool> peer-mic-off;
    in property <bool> peer-camera-off;
    // Nothing is arriving, or the connection is being got back.
    in property <bool> reconnecting;
    // Whose side that is on, as far as this phone can tell.
    in property <Stall> stall;
    // Still working, but struggling: whose side.
    in property <Weak> weak;
    in property <CallCapture> capture;
    // We asked to switch to video and have no answer yet.
    in property <bool> asking;
    // They answered our ask by keeping it voice; said until we ask again.
    in property <bool> kept-voice;
    in property <length> top-inset;
    in property <length> bottom-inset;
    callback accept();
    callback reject();
    callback hangup();
    callback toggle-mic();
    // The Audio key, which opens the sheet: where the sound goes, and mute.
    callback audio();
    callback toggle-camera();
    callback flip-camera();
    callback minimise();
    callback ask-video(bool);
    callback call-again();
    callback close();
    background: Theme.video;

    property <bool> connected: state == CallState.connected;
    property <bool> incoming: state == CallState.incoming;
    property <bool> lost: state == CallState.lost;
    property <bool> video: !root.voice && !root.lost;
    // Their picture is not worth showing: their camera is off, or their phone holds the call.
    property <bool> peer-away: root.connected && root.video && (root.peer-camera-off || root.peer-held);
    // Ours stopped: turned off, or held by a phone call.
    property <bool> camera-stopped: !root.camera-on || root.held;
    // Hold is not the network: nothing about reconnecting or a weak link while either side holds.
    property <bool> stalled: root.reconnecting && !root.held && !root.peer-held;
    property <Weak> weak-shown: root.held || root.peer-held ? Weak.none : root.weak;
    property <Output> output: root.output-index >= 0 && root.output-index < root.outputs.length
        ? root.outputs[root.output-index].output : Output.speaker;
    property <string> output-name: root.output-index >= 0 && root.output-index < root.outputs.length
        && root.outputs[root.output-index].name != "" ? root.outputs[root.output-index].name
        : root.output == Output.phone ? @tr("Phone")
        : root.output == Output.bluetooth ? @tr("Bluetooth")
        : root.output == Output.wired ? @tr("Wired headphones")
        : @tr("Speaker");

    // Under everything on the call, so a tap nothing here takes stops here. The picture that
    // fills the screen takes none, and a tap on it went through to the page beneath — a
    // contact opened, or a call placed, from a tap on your own face.
    TouchArea { }

    if root.video : Image {
        width: parent.width;
        height: parent.height;
        source: root.connected && !root.swapped ? root.remote-frame : root.frame;
        image-fit: cover;
    }

    // Our picture fills the screen (swapped, or not yet connected) with the camera off.
    if root.video && root.camera-stopped && (root.swapped || !root.connected) : CameraOff { }

    // Their camera is off, or they are on a phone call: them, not a frozen frame, which would
    // read as the network.
    if root.peer-away && !root.swapped : Rectangle {
        background: Theme.video;
        VerticalLayout {
            alignment: center;
            spacing: Theme.peer-off-gap;
            padding-top: root.top-inset;
            padding-bottom: root.bottom-inset + Theme.peer-off-lift;
            BigAvatar { initial: root.peer-initial; }
            Text {
                text: root.peer-name;
                color: Theme.on-video;
                font-family: Theme.display;
                font-size: 1.1875rem;
                font-weight: 600;
                height: self.font-size * Theme.line-box;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                Flag {
                    icon: root.peer-held ? @image-url("icons/pause.svg") : @image-url("icons/video-off.svg");
                    text: root.peer-held ? @tr("On hold") : @tr("Camera off");
                }
            }
            if root.peer-held : Text {
                text: @tr("{} is on a phone call", root.peer-name);
                color: Theme.on-video-muted;
                font-size: 0.8125rem;
                height: self.font-size * Theme.line-box;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // The corner card: the whole frame until the call connects, then a card holding whichever
    // of the two pictures is not filling the screen. It depends on `connected` alone — while
    // it also depended on `swapped`, a tap grew the card back to full size and buried the
    // other picture under it, which read as the self view vanishing rather than trading.
    // Dragged, it stays where it was left, between the top bar and the keys; until then it
    // rests in the end corner.
    if root.video : Rectangle {
        property <bool> inset: root.connected;
        property <length> min-x: Theme.self-view-edge;
        property <length> max-x: parent.width - Theme.self-view-width - Theme.self-view-edge;
        property <length> min-y: root.top-inset + Theme.self-view-top;
        property <length> max-y: max(min-y, parent.height - root.bottom-inset - Theme.call-bottom
            - Theme.key-size - Theme.self-view-edge - Theme.self-view-height);
        x: !inset ? 0px : root.card-placed ? clamp(root.card-x, min-x, max-x) : Theme.rtl ? min-x : max-x;
        y: !inset ? 0px : root.card-placed ? clamp(root.card-y, min-y, max-y) : min-y;
        width: inset ? Theme.self-view-width : parent.width;
        height: inset ? Theme.self-view-height : parent.height;
        border-radius: inset ? Theme.self-view-edge : 0px;
        border-width: inset ? 1px : 0px;
        border-color: #FFFFFF2D;
        clip: true;
        visible: root.connected;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.swapped ? root.remote-frame : root.frame;
            image-fit: cover;
        }
        if root.camera-stopped && !root.swapped : CameraOff { }
        // Theirs, when they are the one in the card.
        if root.peer-away && root.swapped : CameraOff { }
        if !root.swapped : Rectangle {
            // Inside the card's border, as the design draws it.
            x: 1px;
            width: parent.width - 2px;
            y: parent.height - self.height - 1px;
            height: Theme.self-label-height;
            background: @linear-gradient(0deg, #0000008C 0%, #00000000 100%);
            Text {
                x: Theme.rtl ? parent.width - self.width - Theme.self-label-pad : Theme.self-label-pad;
                text: root.held ? @tr("On hold") : root.camera-on ? @tr("You") : @tr("Camera off");
                color: Theme.on-video;
                font-size: 0.6875rem;
                vertical-alignment: center;
            }
        }
        drag := DragTap {
            tapped => { root.swapped = !root.swapped; }
            dragged(dx, dy) => {
                root.card-x = parent.x + dx;
                root.card-y = parent.y + dy;
                root.card-placed = true;
            }
        }
        // Under the finger while dragged, not 620ms behind it.
        animate x, y { duration: 620ms; easing: ease-out-quint; enabled: !drag.dragging; }
        animate width, height, border-radius { duration: 620ms; easing: ease-out-quint; }
    }

    // Ringing and incoming video: the name over a dimmed camera.
    if root.video && !root.connected : Rectangle {
        background: #070A0FB3;
        VerticalLayout {
            alignment: center;
            spacing: Theme.call-top;
            padding-bottom: parent.height / 4;
            BigAvatar { initial: root.peer-initial; }
            Text {
                text: root.peer-name;
                color: Theme.on-video;
                font-family: Theme.display;
                font-size: 1.4375rem;
                font-weight: 600;
                height: self.font-size * Theme.line-box;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Text {
                text: root.incoming ? @tr("Incoming video call") : @tr("Calling…");
                color: Theme.on-video-muted;
                font-size: 0.9375rem;
                height: self.font-size * Theme.line-box;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // A voice call, and a call that has ended with the network: the person in the middle. While
    // a voice call reconnects, the message takes their place and the name moves to the bar.
    if !root.video && !(root.connected && (root.stalled || root.held)) : VoiceFace {
        initial: root.peer-initial;
        name: root.peer-name;
        padding-top: root.top-inset + Theme.voice-edge;
        padding-left: Theme.voice-edge;
        padding-right: Theme.voice-edge;
        padding-bottom: root.bottom-inset + Theme.voice-lift;
        if !root.connected && !root.lost : Text {
            text: root.incoming ? @tr("Incoming voice call") : @tr("Calling…");
            color: Theme.on-video-muted;
            font-size: 0.9375rem;
            height: self.font-size * Theme.line-box;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.lost : Text {
            text: @tr("Connection lost");
            color: Theme.end-call;
            font-size: 0.9375rem;
            font-weight: 600;
            height: self.font-size * Theme.line-box;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.lost : Rectangle { height: Theme.lost-timer-top; }
        if root.connected || root.lost : CallTimer { text: root.timer; }
        // Theirs under their name, as in a video call; ours is in the corner above the keys.
        if root.connected && root.weak-shown == Weak.theirs : HorizontalLayout {
            alignment: center;
            padding-top: Theme.flags-top;
            Flag {
                icon: @image-url("icons/signal-weak.svg");
                icon-size: Theme.weak-icon;
                text: @tr("{}'s connection is weak", root.peer-name);
            }
        }
        // On their phone call: the pill and the line under their name, as over their video.
        if root.connected && root.peer-held : HorizontalLayout {
            alignment: center;
            padding-top: Theme.flags-top;
            Flag {
                icon: @image-url("icons/pause.svg");
                text: @tr("On hold");
            }
        }
        if root.connected && root.peer-held : Text {
            text: @tr("{} is on a phone call", root.peer-name);
            color: Theme.on-video-muted;
            font-size: 0.8125rem;
            height: self.font-size * Theme.line-box;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.connected && root.kept-voice : Rectangle { height: Theme.kept-voice-top; }
        if root.connected && root.kept-voice : Text {
            text: @tr("{} kept it voice", root.peer-name);
            color: Theme.on-video-muted;
            font-size: 0.8125rem;
            height: self.font-size * Theme.line-box;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Nothing arriving: the call is still there, and says it is coming back. The bar and the
    // keys stay over it and keep working.
    if root.connected && root.stalled : Rectangle {
        background: root.video ? Theme.reconnect-scrim : transparent;
        VerticalLayout {
            alignment: center;
            spacing: Theme.reconnect-gap;
            padding-top: root.top-inset;
            padding-left: Theme.reconnect-edge;
            padding-right: Theme.reconnect-edge;
            padding-bottom: root.bottom-inset + Theme.peer-off-lift;
            Dots { padding-bottom: Theme.dots-under; }
            Text {
                text: root.stall == Stall.offline ? @tr("You're offline")
                    : root.stall == Stall.waiting ? @tr("Waiting for {}…", root.peer-name) : @tr("Reconnecting…");
                color: Theme.on-video;
                font-family: Theme.display;
                font-size: 1.25rem;
                font-weight: 600;
                height: self.font-size * Theme.line-box;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                Text {
                    width: min(Theme.reconnect-text, root.width - Theme.reconnect-edge * 2);
                    text: root.stall == Stall.offline ? @tr("The call carries on when your network is back.")
                        : root.stall == Stall.waiting ? @tr("Their connection dropped. The call carries on when they're back.")
                        : @tr("The call carries on when the network is back.");
                    color: Theme.on-video-muted;
                    font-size: 0.875rem;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // A phone call has this one on hold: the same scrim as reconnecting, with a pause mark rather
    // than dots, because nothing is being retried. It comes back by itself when that call ends.
    if root.connected && root.held : Rectangle {
        background: root.video ? Theme.reconnect-scrim : transparent;
        VerticalLayout {
            alignment: center;
            spacing: Theme.held-gap;
            padding-top: root.top-inset;
            padding-left: Theme.reconnect-edge;
            padding-right: Theme.reconnect-edge;
            padding-bottom: root.bottom-inset + Theme.peer-off-lift;
            HorizontalLayout {
                alignment: center;
                padding-bottom: Theme.held-mark-under;
                Rectangle {
                    width: Theme.key-size;
                    height: Theme.key-size;
                    border-radius: self.width / 2;
                    background: Theme.key-fill;
                    border-width: 1px;
                    border-color: Theme.key-edge;
                    Image {
                        source: @image-url("icons/pause.svg");
                        width: Theme.key-icon;
                        height: Theme.key-icon;
                        colorize: Theme.on-video;
                    }
                }
            }
            Text {
                text: @tr("On hold");
                color: Theme.on-video;
                font-family: Theme.display;
                font-size: 1.25rem;
                font-weight: 600;
                height: self.font-size * Theme.line-box;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                Text {
                    width: min(Theme.held-text, root.width - Theme.reconnect-edge * 2);
                    text: @tr("You're on a phone call. {} can't hear or see you until it ends.", root.peer-name);
                    color: Theme.on-video-muted;
                    font-size: 0.875rem;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // Top bar, once connected: fold it away at the start, then who and how long, with what they
    // are doing; how the call is set up at the end. A voice call has the name in the middle,
    // until it reconnects and the middle is taken.
    if root.connected : Rectangle {
        y: 0;
        height: bar.preferred-height;
        background: @linear-gradient(180deg, #04080DBF 0%, #04080D00 100%);
        bar := VerticalLayout {
            padding-top: root.top-inset + Theme.call-top;
            padding-bottom: Theme.call-top;
            padding-left: Theme.call-edge;
            padding-right: Theme.call-edge;
            alignment: start;
            Row {
                alignment: space-between;
                spacing: Theme.call-bar-gap;
                Row {
                    spacing: Theme.fold-gap;
                    cross-axis-alignment: start;
                    Rectangle {
                        width: Theme.fold-size;
                        height: Theme.fold-size;
                        border-radius: self.width / 2;
                        background: Theme.key-fill;
                        border-width: 1px;
                        border-color: Theme.key-edge;
                        accessible-role: button;
                        accessible-label: @tr("Fold away");
                        accessible-action-default => { root.minimise(); }
                        Image {
                            source: @image-url("icons/minimise.svg");
                            width: Theme.fold-icon;
                            height: Theme.fold-icon;
                            colorize: Theme.on-video;
                        }
                        Tap {
                            tapped => { root.minimise(); }
                        }
                    }
                    if root.video || root.stalled || root.held : VerticalLayout {
                        spacing: 3px;
                        Line {
                            text: root.peer-name;
                            color: Theme.on-video;
                            font-family: Theme.display;
                            font-size: 1.1875rem;
                            font-weight: 600;
                            overflow: elide;
                        }
                        // A time is a code: it reads left to right in any language.
                        Line {
                            text: root.timer;
                            color: Theme.on-video-muted;
                            font-size: 1rem;
                            font-family: Theme.mono;
                        }
                        if root.video && root.video-failed : Line {
                            text: @tr("Video isn't working on this phone — audio only");
                            color: Theme.end-call;
                            font-size: 0.8125rem;
                            overflow: elide;
                        }
                        if root.peer-mic-off || (root.weak-shown == Weak.theirs && !root.stalled) : Row {
                            padding-top: Theme.flags-top - 3px;
                            spacing: Theme.flags-gap;
                            if root.peer-mic-off : Flag {
                                icon: @image-url("icons/mic-off.svg");
                                text: @tr("Muted");
                            }
                            if root.weak-shown == Weak.theirs && !root.stalled : Flag {
                                icon: @image-url("icons/signal-weak.svg");
                                icon-size: Theme.weak-icon;
                                text: @tr("{}'s connection is weak", root.peer-name);
                            }
                        }
                    }
                }
            }
        }
    }

    // Controls on their own scrim.
    controls := Rectangle {
        y: parent.height - self.height;
        height: root.bottom-inset + 120px;
        background: @linear-gradient(0deg, #04080DD9 0%, #04080D00 100%);
        VerticalLayout {
            alignment: end;
            padding-bottom: root.bottom-inset + Theme.call-bottom;
            Row {
                alignment: center;
                spacing: Theme.key-gap;
                if root.incoming : Key {
                    icon: @image-url("icons/close.svg");
                    label: @tr("Decline");
                    danger: true;
                    clicked => { root.reject(); }
                }
                if root.incoming : Key {
                    icon: @image-url("icons/call.svg");
                    label: @tr("Answer");
                    positive: true;
                    clicked => { root.accept(); }
                }
                if root.lost : Key {
                    icon: @image-url("icons/close.svg");
                    label: @tr("Close");
                    clicked => { root.close(); }
                }
                if root.lost : Key {
                    icon: @image-url("icons/call.svg");
                    label: @tr("Call again");
                    positive: true;
                    clicked => { root.call-again(); }
                }
                // On hold every key but End call dims: the other call has the mic and the sound.
                if !root.incoming && !root.lost : Key {
                    icon: root.mic-on ? @image-url("icons/mic.svg") : @image-url("icons/mic-off.svg");
                    label: root.mic-on ? @tr("Mute") : @tr("Unmute");
                    on: !root.mic-on;
                    enabled: !root.held;
                    clicked => { root.toggle-mic(); }
                }
                if root.connected && root.video : Key {
                    icon: root.camera-on ? @image-url("icons/video-key.svg") : @image-url("icons/video-off.svg");
                    label: root.camera-on ? @tr("Turn camera off") : @tr("Turn camera on");
                    on: !root.camera-on;
                    enabled: !root.held;
                    clicked => { root.toggle-camera(); }
                }
                if root.connected && root.video : Key {
                    icon: @image-url("icons/camera-switch.svg");
                    label: @tr("Switch camera");
                    enabled: root.camera-on && !root.held;
                    clicked => { root.flip-camera(); }
                }
                // Draws where the sound goes; never filled, because it is a choice, not a switch.
                if root.connected : Key {
                    icon: root.silenced ? @image-url("icons/speaker-off.svg")
                        : root.output == Output.phone ? @image-url("icons/call.svg")
                        : root.output == Output.bluetooth ? @image-url("icons/bluetooth.svg")
                        : root.output == Output.wired ? @image-url("icons/headphones.svg")
                        : @image-url("icons/speaker.svg");
                    label: @tr("Audio: {}", root.silenced ? @tr("Mute") : root.output-name);
                    enabled: !root.held;
                    clicked => { root.audio(); }
                }
                // Asks, and while the question is open, takes it back.
                if root.connected && !root.video : Key {
                    icon: @image-url("icons/video-key.svg");
                    label: root.asking ? @tr("Asking to switch to video") : @tr("Switch to video");
                    on: root.asking;
                    enabled: !root.reconnecting && !root.held;
                    clicked => { root.ask-video(!root.asking); }
                }
                if !root.incoming && !root.lost : Key {
                    icon: @image-url("icons/call-end.svg");
                    label: @tr("End call");
                    danger: true;
                    clicked => { root.hangup(); }
                }
            }
        }
    }

    // How the call travels, in the start corner just above the keys: the top end is the self
    // view's. The route, because a relayed call explains a bad one; the encryption is not said,
    // being always the same. Our own weak pill over it, on our side of the screen, so it is never
    // read as theirs. The open question to switch to video takes this spot while it shows.
    if root.connected && !root.stalled && !root.held && !root.asking && (root.route != Route.unknown || root.weak-shown == Weak.ours || root.weak-shown == Weak.both || root.capture != CallCapture.none) : VerticalLayout {
        x: Theme.rtl ? parent.width - self.width - Theme.self-view-edge : Theme.self-view-edge;
        y: parent.height - root.bottom-inset - Theme.call-bottom - Theme.key-size - Theme.asking-lift - self.height;
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: Theme.flags-gap;
        if root.weak-shown == Weak.ours || root.weak-shown == Weak.both : HorizontalLayout {
            alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
            Flag {
                icon: @image-url("icons/signal-weak.svg");
                icon-size: Theme.weak-icon;
                text: root.weak-shown == Weak.both ? @tr("Weak connection") : @tr("Your connection is weak");
            }
        }
        if root.route != Route.unknown : HorizontalLayout {
            alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
            Chip {
                // In the accent the encryption chip had, which reads over any picture.
                text: root.route == Route.direct ? @tr("Direct") : @tr("Relayed");
                fill: #58B6FF29;
                edge: #58B6FF4C;
                ink: Theme.on-video-accent;
            }
        }
        // This call cannot be captured on their phone, in the route chip's style: a fact about
        // the call, not a warning.
        if root.capture == CallCapture.blocked : HorizontalLayout {
            alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
            Chip {
                text: @tr("No screenshots");
                fill: #58B6FF29;
                edge: #58B6FF4C;
                ink: Theme.on-video-accent;
            }
        }
        // Asked, and their app never said it could: an older build.
        if root.capture == CallCapture.unsupported : HorizontalLayout {
            alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
            Flag {
                icon: @image-url("icons/camera-off.svg");
                icon-size: Theme.weak-icon;
                text: @tr("{}'s app can't block screenshots", root.peer-name);
            }
        }
    }

    // The question is open: who was asked, and a way to take it back.
    if root.connected && root.asking : Rectangle {
        x: Theme.self-view-edge;
        width: parent.width - Theme.self-view-edge * 2;
        height: Theme.asking-height;
        y: parent.height - root.bottom-inset - Theme.call-bottom - Theme.key-size - Theme.asking-lift - self.height;
        border-radius: Theme.asking-radius;
        background: Theme.asking-fill;
        border-width: 1px;
        border-color: Theme.key-edge;
        Row {
            padding-left: Theme.asking-pad;
            padding-right: Theme.asking-pad;
            spacing: Theme.call-bar-gap;
            cross-axis-alignment: center;
            Text {
                horizontal-stretch: 1;
                text: @tr("Asking {} to switch to video…", root.peer-name);
                color: Theme.on-video;
                font-size: 0.875rem;
                overflow: elide;
                horizontal-alignment: Theme.start;
                vertical-alignment: center;
            }
            Text {
                text: @tr("Cancel");
                color: Theme.on-video-beacon;
                font-size: 0.875rem;
                font-weight: 600;
                vertical-alignment: center;
                accessible-role: button;
                accessible-label: self.text;
                accessible-action-default => { root.ask-video(false); }
                Tap {
                    tapped => { root.ask-video(false); }
                }
            }
        }
    }
}
