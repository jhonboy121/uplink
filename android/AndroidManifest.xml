<?xml version="1.0" encoding="utf-8"?>
<!--
  Compiled to binary XML by `android-res compile`. ${…} is only what the build uses too (the
  package and activity for adb, the library it builds, the minSdk d8 and the linker target) and
  what differs per build (debuggable); everything else is the app's own and is written here.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="${package}"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-sdk android:minSdkVersion="${minSdk}" android:targetSdkVersion="37" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A call keeps the camera and microphone while the app is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- A Telecom call: what keeps the microphone working with the screen locked (API 34+), and
         the type left when camera and microphone are refused from the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <!-- Waiting for a call is not any of Android's named service types, and it is the only type
         a BOOT_COMPLETED receiver may still start. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Listening again after a reboot or an update, without anyone opening the app. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- A ringing call: over the lock screen, and vibrating. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The one-tap dialog for leaving battery optimisation. Without it the user is sent to a
         list of every app to find us in. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Calls go through Telecom as a self-managed app: audio mode, routes, headset buttons and
         hold are the system's. A normal permission, granted at install. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- The proximity lock: a voice call on the earpiece turns the screen off at the ear. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- From Android 11 another app's component resolves to nothing unless its package is named
         here, installed or not. These are the makers whose background lists we can offer; see
         UplinkApplication.MAKER_LISTS. -->
    <queries>
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.oneplus.security" />
        <package android:name="com.asus.mobilemanager" />
    </queries>

    <!-- Our own Application: it exists before any activity, service or receiver, which makes it
         the one thing the app can be driven through when nobody is looking at the screen. -->
    <application
        android:name="dev.uplink.UplinkApplication"
        android:label="uplink"
        android:icon="@mipmap/launcher"
        android:roundIcon="@mipmap/launcher"
        android:theme="@style/Theme.Uplink"
        android:hasCode="true"
        android:debuggable="${debuggable}"
        android:hardwareAccelerated="true">

        <!-- configChanges: the native side handles these rather than being restarted.
             windowSoftInputMode adjustResize: under the enforced edge-to-edge of recent target
             levels the window is not actually resized; the keyboard arrives as an inset, which
             the UI reads as `virtual-keyboard-size`. The flag stays for the levels and display
             modes where Android still honours it. The words are the SDK's own constants
             (`just android-table`). -->
        <activity
            android:name="${activity}"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="${lib}" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serves the one cache directory a shared picture is written to. Not exported: a target
             the user picked from the chooser reads the URI it was granted, and nothing else. -->
        <provider
            android:name="dev.uplink.UplinkFiles"
            android:authorities="${package}.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- The property says what the special use is, which is what the type asks of anyone who
             declares it. -->
        <service
            android:name="dev.uplink.UplinkListenService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Holds the peer-to-peer endpoint open so incoming calls can arrive" />
        </service>

        <!-- Telecom binds this for every call, placed or received. Exported, but only the system
             holds BIND_TELECOM_CONNECTION_SERVICE. -->
        <service
            android:name="dev.uplink.UplinkConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <!-- Exported because the system sends BOOT_COMPLETED; MY_PACKAGE_REPLACED only ever
             reaches the package that was replaced. -->
        <receiver
            android:name="dev.uplink.UplinkBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- phoneCall is the Telecom call itself, and the fallback when Android refuses the other
             two because the app was not in front, which keeps the call up rather than crashing it. -->
        <service
            android:name="dev.uplink.UplinkCallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|camera|microphone" />
    </application>
</manifest>
